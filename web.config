<?xml version="1.0" encoding="UTF-8"?>
<!--
  Master Hub — IIS web.config
  Requires:
    - IIS URL Rewrite 2.x  (https://www.iis.net/downloads/microsoft/url-rewrite)
    - Application Request Routing (ARR)  (https://www.iis.net/downloads/microsoft/application-request-routing)
    - ARR proxy MUST be enabled at server level in IIS Manager

  Routing:
    /api/*          → Laravel backend    http://localhost:8000
    /phpmyadmin/*   → phpMyAdmin GUI     http://localhost:8080
    /* (default)    → React frontend     http://localhost:5173
-->
<configuration>
  <system.webServer>

    <!-- ── Security: Prevent directory browsing ──────────────────────────── -->
    <directoryBrowse enabled="false" />

    <!-- ── Request size limit (for file uploads) ─────────────────────────── -->
    <security>
      <requestFiltering>
        <requestLimits maxAllowedContentLength="104857600" /> <!-- 100 MB -->
      </requestFiltering>
    </security>

    <!-- ── URL Rewrite + Reverse Proxy Rules ─────────────────────────────── -->
    <rewrite>
      <rules>

        <!-- Rule 0: HTTP → HTTPS redirect ─────────────────────────────────── -->
        <rule name="HTTP to HTTPS Redirect" stopProcessing="true">
          <match url="(.*)" />
          <conditions>
            <add input="{HTTPS}" pattern="^OFF$" ignoreCase="true" />
          </conditions>
          <action type="Redirect"
                  url="https://{HTTP_HOST}/{R:1}"
                  redirectType="Permanent" />
        </rule>

        <!-- Rule 1: /api/* → Laravel backend :8000 ─────────────────────── -->
        <rule name="Laravel API Proxy" stopProcessing="true">
          <match url="^api/(.*)" />
          <conditions>
            <add input="{HTTPS}" pattern="^ON$" ignoreCase="true" />
          </conditions>
          <action type="Rewrite"
                  url="http://localhost:8000/api/{R:1}"
                  appendQueryString="true" />
        </rule>

        <!-- Rule 2: /phpmyadmin/* → phpMyAdmin :8080 ───────────────────── -->
        <rule name="phpMyAdmin Proxy" stopProcessing="true">
          <match url="^phpmyadmin/(.*)" />
          <conditions>
            <add input="{HTTPS}" pattern="^ON$" ignoreCase="true" />
          </conditions>
          <action type="Rewrite"
                  url="http://localhost:8080/{R:1}"
                  appendQueryString="true" />
        </rule>

        <!-- Rule 3: /* → React/Vite frontend :5173 (catch-all) ─────────── -->
        <rule name="React Frontend Proxy" stopProcessing="true">
          <match url="(.*)" />
          <conditions>
            <add input="{HTTPS}" pattern="^ON$" ignoreCase="true" />
          </conditions>
          <action type="Rewrite"
                  url="http://localhost:5173/{R:1}"
                  appendQueryString="true" />
        </rule>

      </rules>

      <!-- ── Outbound rules: Fix Location headers from proxied services ──── -->
      <outboundRules>
        <rule name="Fix Location Headers" preCondition="IsRedirect">
          <match serverVariable="RESPONSE_Location" pattern="^http://localhost:(8000|8080|5173)/(.*)" />
          <action type="Rewrite" value="https://{HTTP_HOST}/{R:2}" />
        </rule>
        <preConditions>
          <preCondition name="IsRedirect">
            <add input="{RESPONSE_STATUS}" pattern="3[0-9][0-9]" />
          </preCondition>
        </preConditions>
      </outboundRules>

    </rewrite>

    <!-- ── Allow WebSocket connections (for Vite HMR) ────────────────────── -->
    <webSocket enabled="true" />

    <!-- ── Custom error pages (optional, prevents IIS default error pages) ─ -->
    <httpErrors errorMode="DetailedLocalOnly" existingResponse="PassThrough" />

  </system.webServer>
</configuration>
